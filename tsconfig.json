{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "skipLibCheck": true, "resolveJsonModule": true, "types": ["node"], "noEmit": true, "allowImportingTsExtensions": true
  },
  "include": ["server/**/*.ts", "shared/**/*.ts", "tests/**/*.ts", "fixtures/**/*.ts"]
}
